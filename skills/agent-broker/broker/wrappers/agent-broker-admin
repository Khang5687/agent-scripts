#!/bin/bash
# agent-broker-admin: owner-only broker management; sudo asks for your Mac password. Token values are read here
# (hidden from the keyboard, from stdin, or from a .env file) and handed to the broker on stdin, never as arguments.
# Guide: agent-scripts/skills/agent-broker/SKILL.md
set -euo pipefail
ADMIN=(/usr/bin/sudo -u _deployer /opt/agent-broker/bin/agent-broker-admin.mjs)

case "${1:-}" in
  set)
    [ $# -eq 3 ] || { echo "usage: agent-broker-admin set <project> <KEY>" >&2; exit 2; }
    if [ -t 0 ]; then
      IFS= read -rsp "Value for $3 (hidden, paste then Enter): " value
      echo
    else
      IFS= read -r value || true # piped in (e.g. by the wizard); sudo still asks for the password on the terminal
    fi
    printf '%s' "$value" | "${ADMIN[@]}" set "$2" "$3"
    ;;
  import)
    # import <project> <env-file> <KEY>...: moves the keys into the broker, then deletes those lines from the file.
    [ $# -ge 4 ] || { echo "usage: agent-broker-admin import <project> <env-file> <KEY>..." >&2; exit 2; }
    project=$2 file=$3
    shift 3
    [ -f "$file" ] || { echo "no such file: $file" >&2; exit 2; }
    lines=""
    for key in "$@"; do
      [[ $key =~ ^[A-Z][A-Z0-9_]*$ ]] || { echo "invalid key name: $key" >&2; exit 2; }
      line=$(grep -m1 "^$key=" "$file" || true)
      [ -n "$line" ] || { echo "$key is not in $file" >&2; exit 2; }
      lines+="$line"$'\n'
    done
    printf '%s' "$lines" | "${ADMIN[@]}" import "$project"
    pattern=$(printf '^%s=|' "$@")
    kept=$(grep -vE "${pattern%|}" "$file" || true)
    printf '%s\n' "$kept" > "$file" # same file (same permissions), without the moved keys
    echo "removed $* from $file"
    ;;
  *)
    exec "${ADMIN[@]}" "$@"
    ;;
esac
